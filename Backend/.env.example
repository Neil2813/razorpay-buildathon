# AWS Architecture & Serverless Configuration (AWS Production Cloud Mode)
ENABLE_AWS_SERVERLESS=true
ENABLE_AWS_STEP_FUNCTIONS=true
ENABLE_AWS_EVENTBRIDGE=true
ENABLE_AWS_DYNAMODB=true
ENABLE_AWS_OPENSEARCH=true
ENABLE_AWS_S3=true
ENABLE_AWS_ELASTICACHE=true
ENABLE_AWS_SQS=true
ENABLE_AWS_WAF=true

# AWS Region & Production Resource Identifiers
AWS_REGION=ap-south-1
AWS_EVENTBUS_NAME=glassbox-events
AWS_STEP_FUNCTIONS_ARN=arn:aws:states:ap-south-1:123456789012:stateMachine:GlassBoxAgentOrchestrator-prod
DYNAMODB_TABLE_NAME=glassbox_transactions
OPENSEARCH_ENDPOINT=search-glassbox-domain.ap-south-1.es.amazonaws.com
S3_AUDIT_BUCKET=glassbox-audit-vault-logs
ELASTICACHE_REDIS_URL=redis://glassbox-cache.xxxxxx.ng.0001.aps1.cache.amazonaws.com:6379
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/glassbox-processing-queue
SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/glassbox-dlq
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net

# Server & Security Credentials
JWT_SECRET_KEY=glassbox_jwt_secret_key_change_in_production_32bytes

# Database Configuration
# DATABASE_PATH=glassbox.db

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=glassbox_webhook_secret_key

# LLM Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx

# SerpAPI Configuration
SERPAPI_API_KEY=
