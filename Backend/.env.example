# AWS Architecture & Serverless Configuration (AWS Serverless Production Mode)
ENABLE_AWS_SERVERLESS=true
ENABLE_AWS_STEP_FUNCTIONS=true
ENABLE_AWS_EVENTBRIDGE=true
AWS_REGION=ap-south-1
AWS_EVENTBUS_NAME=glassbox-events
AWS_STEP_FUNCTIONS_ARN=arn:aws:states:ap-south-1:123456789012:stateMachine:GlassBoxAgentOrchestrator-dev
CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net

# Server & Security Credentials
JWT_SECRET_KEY=glassbox_jwt_secret_key_change_in_production_32bytes

# Database Configuration
# DATABASE_PATH=glassbox.db


# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=glassbox_webhook_secret_key

# LLM Keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxx

# SerpAPI Configuration
SERPAPI_API_KEY=

